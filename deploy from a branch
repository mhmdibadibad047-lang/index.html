<!Doctype html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teknologi Masa Depan</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #050816;
            color: white;
            text-align: center;
        }

        header {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            padding: 30px;
            background: radial-gradient(circle, #172554, #050816 70%);
        }

        .robot {
            font-size: 90px;
            animation: melayang 3s infinite ease-in-out;
        }

        @keyframes melayang {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-20px);
            }
        }

        h1 {
            font-size: 45px;
            margin: 20px 0;
        }

        h1 span {
            color: #00eaff;
        }

        .typing {
            font-size: 20px;
            color: #b8c7ff;
            min-height: 30px;
        }

        button {
            margin-top: 30px;
            padding: 14px 30px;
            border: none;
            border-radius: 30px;
            background: #00eaff;
            color: #001018;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            transform: scale(1.1);
            box-shadow: 0 0 25px #00eaff;
        }

        section {
            padding: 70px 20px;
        }

        h2 {
            font-size: 32px;
            margin-bottom: 40px;
            color: #00eaff;
        }

        .container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
            max-width: 1000px;
            margin: auto;
        }

        .card {
            background: #10172a;
            padding: 30px;
            border-radius: 20px;
            border: 1px solid #24345c;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 0 25px #00eaff55;
        }

        .icon {
            font-size: 50px;
            margin-bottom: 15px;
        }

        .card h3 {
            color: #00eaff;
            margin-bottom: 10px;
        }

        .card p {
            color: #cbd5e1;
            line-height: 1.6;
        }

        footer {
            padding: 25px;
            background: #020617;
            color: #94a3b8;
        }
    </style>
</head>

<body>

    <!-- HALAMAN UTAMA -->
    <header>
        <div class="robot">🤖</div>

        <h1>Teknologi <span>Masa Depan</span></h1>

        <p class="typing" id="typing"></p>

        <button onclick="lihatTeknologi()">
            Jelajahi Teknologi 🚀
        </button>
    </header>


    <!-- DAFTAR TEKNOLOGI -->
    <section id="teknologi">

        <h2>🚀 Teknologi Masa Depan</h2>

        <div class="container">

            <div class="card">
                <div class="icon">🤖</div>
                <h3>Artificial Intelligence</h3>
                <p>
                    AI dapat membantu manusia dalam belajar,
                    bekerja, menganalisis data, dan menyelesaikan
                    berbagai masalah.
                </p>
            </div>

            <div class="card">
                <div class="icon">🚗</div>
                <h3>Mobil Otonom</h3>
                <p>
                    Kendaraan yang menggunakan sensor dan AI
                    untuk membantu atau melakukan perjalanan
                    tanpa dikendalikan manusia secara langsung.
                </p>
            </div>

            <div class="card">
                <div class="icon">🥽</div>
                <h3>Virtual Reality</h3>
                <p>
                    Teknologi yang membuat pengguna dapat
                    merasakan pengalaman berada di dunia virtual.
                </p>
            </div>

            <div class="card">
                <div class="icon">🧬</div>
                <h3>Bioteknologi</h3>
                <p>
                    Pemanfaatan teknologi dalam bidang biologi
                    untuk membantu kesehatan, pangan, dan kehidupan.
                </p>
            </div>

            <div class="card">
                <div class="icon">🌐</div>
                <h3>Internet of Things</h3>
                <p>
                    Perangkat dapat saling terhubung melalui
                    internet dan bertukar informasi secara otomatis.
                </p>
            </div>

            <div class="card">
                <div class="icon">🚀</div>
                <h3>Eksplorasi Luar Angkasa</h3>
                <p>
                    Teknologi baru memungkinkan manusia
                    menjelajahi bulan, Mars, dan luar angkasa.
                </p>
            </div>

        </div>
    </section>


    <footer>
        © 2026 Teknologi Masa Depan | Dibuat oleh
        muhamadibadlinks23
    </footer>


    <script>

        // Efek tulisan berjalan
        const text =
        "Masa depan dimulai dari teknologi dan kreativitas...";

        let index = 0;

        function ketik() {

            if (index < text.length) {
                document.getElementById("typing").innerHTML += text.charAt(index);
                index++;

                setTimeout(ketik, 70);
            }

        }

        ketik();


        // Tombol menuju bagian teknologi
        function lihatTeknologi() {

            document.getElementById("teknologi").scrollIntoView({
                behavior: "smooth"
            });

        }

    </script>

</body>
</html>
